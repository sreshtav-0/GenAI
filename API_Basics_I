import os
import datetime
import requests
from pprint import pprint
from dotenv import load_dotenv
from typing import Callable, Dict
load_dotenv()

RED = "\033[91m"
GREEN = "\033[92m"
YELLOW = "\033[93m"
BLUE = "\033[94m"
MAGENTA = "\033[95m"
CYAN = "\033[96m"
WHITE = "\033[97m"
ORANGE = "\033[38;5;208m"
RESET = "\033[0m"

def get_api_key():
    return os.getenv("OPEN_WEATHER_MAP")

print(get_api_key())

def get_city()-> str:
    city = input("Enter city name: ").strip().lower()
    return city

def fetch_weather_data(api_key_func: Callable, city_func: Callable, units:"imperial") -> Dict:
    api_key = api_key_func()
    city = city_func()
    url = f"https://api.openweathermap.org/data/2.5/weather?q={city}&appid={api_key}&units={units}&lang=en"
    response = requests.get(url).json()
    return response

def parse_datetime(timestamp: int, timezone_offset: int) -> str:
    dt = datetime.datetime.utcfromtimestamp(timestamp + timezone_offset)
    return dt.strftime("%Y-%m-%d %H:%M:%S")

def display_weather_data(weather_data: Dict, city: str):
    print(f"{MAGENTA}\nWeather report for {city.upper()}")
    
    main_data = weather_data["main"]
    print(f"{CYAN}Temperature: {main_data['temp']}°F")
    print(f"{GREEN}Feels Like: {main_data['feels_like']}°F")
    print(f"{BLUE}Humidity: {main_data['humidity']}%")
    print(f"{MAGENTA}Pressure: {main_data['pressure']} hPa")
    print(f"{YELLOW}Low Temp: {main_data['temp_min']}°F")
    print(f"{YELLOW}High Temp: {main_data['temp_max']}°F")

    desc = weather_data["weather"][0]["description"]
    print(f"{CYAN}Conditions: {desc['main']} - {desc['description']}")
    sun = weather_data["sys"]
    timezone = weather_data["timezone"]
    sunrise = parse_datetime(sun["sunrise"], timezone)
    sunset = parse_datetime(sun["sunset"], timezone)
    print(f"{WHITE}Sunrise: {sunrise}")
    print(f"{RED}Sunset: {sunset}\n")
    # Wind Informtion 
    print(f"{BLUE}Wind Speed: {weather_data['wind']['speed']}mph\nWind Direction: {weather_data['wind']['deg']}°")
    # Visibility 
    print(f"{ORANGE}Visibility: {weather_data['visibility']//1000}km")

def main():
    weather_data = fetch_weather_data(get_api_key, get_city, 'imperial')
    if weather_data:
        city = weather_data["name"]
        display_weather_data(weather_data, city)

if __name__ == "__main__":
    main()
# Example usage

import asyncio
import requests
import time

RED = "\033[31;1m"
GREEN = "\033[32;1m"
YELLOW = "\033[33;1m"
BLUE = "\033[34;1m"
PURPLE = "\033[35;1m"
CYAN = "\033[36;1m"
WHITE = "\033[37;1m"
ORANGE = "\033[38;5;208m"

def fetch_sync(url):
    print(f"{BLUE}Starting to request to {url}")
    response = requests.get(url)
    print(f"{GREEN}Completed request to {url} with status code {response.status_code}")
    return response.json()

async def fetch_async(url):
    print(f"{YELLOW}Starting request")
    response = await asyncio.to_thread(requests.get(url))
    print(f"{GREEN}Completed request to {url}")
    return response.json() 

if __name__ == "__main__":
    urls = ["https://jsonplaceholder.typicode.com/todos/1",
            "https://jsonplaceholder.typicode.com/todos/2",
            "https://jsonplaceholder.typicode.com/todos/3"]
    
    start = time.time()
    for url in range(0, 10):
        fetch_sync(urls[0])
    end = time.time()
    
    print(f"{ORANGE}Total time: {(end - start)*1000} seconds")
async def greet(name, delay):
    print(f"{BLUE}Hello, {name}!")
    await asyncio.sleep(delay)
    print(f"{PURPLE}Goodbye, {name}!")
    return f"{GREEN}Processed {name}!"

async def main():
    result = await greet("Sreshtav", 2)
    
    results = await asyncio.gather(
        greet("Alice", 3),
        greet("Bob", 1),
        greet("Charlie", 2)
    )

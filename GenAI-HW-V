import requests

def fetch_recipe(dish_name: str = "grilled chicken"):
    """Fetches a recipe from TheMealDB by dish name and prints it neatly."""
    url = f"https://www.themealdb.com/api/json/v1/1/search.php?s={dish_name}"
    
    try:
        response = requests.get(url, timeout=15)
        response.raise_for_status()
    except requests.exceptions.RequestException:
        print("⚠️ Check your internet connection or try again later.")
        return
    
    data = response.json()
    
    if not data["meals"]:
        print("❌ Sorry, no recipe found.")
        return
    
    # Take the first recipe
    meal = data["meals"][0]
    
    # Extract core info
    name = meal.get("strMeal", "N/A")
    category = meal.get("strCategory", "N/A")
    area = meal.get("strArea", "N/A")
    instructions = meal.get("strInstructions", "N/A").strip()
    youtube = meal.get("strYoutube", "").strip()
    image = meal.get("strMealThumb", "").strip()
    
    # Print main details
    print(f"\n🍽 Recipe: {name}")
    print(f"📂 Category: {category}")
    print(f"🌍 Area: {area}\n")
    
    # Ingredients
    print("🥕 Ingredients:")
    for i in range(1, 21):
        ingredient = meal.get(f"strIngredient{i}", "").strip()
        measure = meal.get(f"strMeasure{i}", "").strip()
        if ingredient:  # skip empty ones
            print(f" - {ingredient}: {measure}")
    
    # Instructions
    print("\n📖 Instructions:")
    print(instructions)
    
    # Optional links
    if youtube:
        print(f"\n▶️ YouTube: {youtube}")
    if image:
        print(f"🖼 Image: {image}")


if __name__ == "__main__":
    dish = input("Enter a dish name (press Enter for 'grilled chicken'): ").strip()
    if dish.strip().lower() == "grilled chicken":
        dish = "grilled chicken"
    fetch_recipe(dish)
